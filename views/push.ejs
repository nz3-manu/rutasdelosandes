<html>
  <head>
    <title> push notifications </title>
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
    <script src="https://code.jquery.com/jquery-3.4.1.slim.min.js" integrity="sha256-pasqAKBDmFT4eHoN2ndd6lN370kFiGUFyTiUHWhU7k8=" crossorigin="anonymous"></script>
<style>
label {
  display: block;
  margin-bottom: .5rem;
  font-weight: 600;
  font-family: sans-serif;
}
</style>
  </head>
  <body>
    <div class="container">
      <div class="row">
        <div class="col-md-7">
          <h2>Push notification</h2>
          <form id="push-form" action="/api/trigger-push-msg/" method="post">
            <label for="title"> notificaction title</label>
            <input type="text" id="title" style="width: 300px;" placeholder="nueva ruta nevado del ruiz!! " maxlength="30" name="title"><br>
            <label for="body"> body</label>
            <textarea type="text" style="width: 100%;" id="body" placeholder="bella ruta que no te puedes perder en el eje cafetero has click para descubrirla" name="body"></textarea><br>
            <label for="image"> image </label>
            <input type="text"  style="width: 100%;" id="image" placeholder="https://rutasdelosandes.com/images/rutas/caldas/ruiz/featured.jpg" name="image"><br>
            <label for="url"> url de la ruta </label>
            <input type="text" style="width: 100%;" id="url" placeholder="https://rutasdelosandes.com/colombia/antioquia/cerro-tusa.html" name="url"><br>
            <label for="id"> id de referencia para google analitycs</label>
            <input type="text" id="id" placeholder="RutaNevadoRuiz" name="id"><br>
            <label for="secret"> password </label>
            <input type="text" id="secret" placeholder="*****" name="secret"><br>
            <input type="submit" value="Enviar">
          </form>
        </div>
        <div class="col-md-5">
          <h2>Push notifications status</h2>
          <p>
            Numero de Usuario en Notificaciones push: <%= userNumber %>
          </p>
        </div>
      </div>
      <div class="row">
        <img src="https://developers.google.com/web/fundamentals/push-notifications/images/notification-ui.png" />
      </div>
    </div>
    <div class="loading-container d-none">
      <img class="loading" src="https://cdnjs.cloudflare.com/ajax/libs/galleriffic/2.0.1/css/loader.gif" alt width="48" height="48">
    </div>
    <script>
      $("#push-form").submit(function(event){
        $(".loading-container").fadeIn();
      })
    </script>
  </body>
</html>
