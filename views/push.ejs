<html>
  <head>
    <title> push notifications </title>
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
  </head>
  <body>
    <div class="container">
      <div class="row">
        <div class="col-md-7">
          <h2>Push notification</h2>
          <form action="/api/trigger-push-msg/" method="post">
            <label for="title"> notificaction title</label>
            <input type="text" id="title" style="width: 300px;" placeholder="nueva ruta nevado del ruiz!! " maxlength="20" name="title"><br>
            <label for="body"> body</label>
            <input type="text" style="width: 450px;" id="body" placeholder="bella ruta que no te puedes perder en el eje cafetero has click para descubrirla" name="body"><br>
            <label for="image"> imagen </label>
            <input type="text"  style="width: 450px;" id="image" placeholder="https://rutasdelosandes.com/images/rutas/caldas/ruiz/featured.jpg" name="image"><br>
            <label for="url"> url de la ruta </label>
            <input type="text" style="width: 450px;" id="url" placeholder="https://rutasdelosandes.com/colombia/antioquia/cerro-tusa.html" name="url"><br>
            <label for="id"> id de referencia para google analitycs</label>
            <input type="text" id="id" placeholder="RutaNevadoRuiz" name="id"><br>
            <label for="secret"> password </label>
            <input type="text" id="secret" placeholder="*****" name="secret"><br>
            <input type="submit" value="Submit">
          </form>
        </div>
        <div class="col-md-5">
          <h2>Push notifications status</h2>
          <p>
            Numero de Usuario en Notificaciones push: <%= userNumber %>
          </p>
        </div>
      </div>
      <div class="row">
        <img src="https://developers.google.com/web/fundamentals/push-notifications/images/notification-ui.png" />
      </div>
    </div>
  </body>
</html>
