      background: #fff;
    }

    .lightbox {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
    }

    .ampTabContainer {
        display: flex;
        flex-wrap: wrap;
        margin: 20px 0;
    }

    .tabButton {
        list-style: none;
        text-align: center;
        cursor: pointer;
        outline: none;
    }

    amp-selector [option][selected] {
      outline: #fff;
    }

    .tabContent {
        line-height: 1.5rem;
        margin-top: 5px;
        display: none;
        width: 100%;
        order: 1; /* must be greater than the order of the tab buttons to flex to the next line */
    }

    .tabButton[selected]::after {
      content: '';
      display: block;
      height: 4px;
      background: -webkit-gradient(linear,left top, right top,color-stop(0, #000000),to(#8a8a8a));    
      background: -webkit-linear-gradient(left,#000000 0,#8a8a8a);    
      background: -o-linear-gradient(left,#000000 0,#8a8a8a);    
      background: linear-gradient(90deg,#000000 0,#8a8a8a);
    }

    .tabButton[selected]+.tabContent {
        display: block;
    }

    .items, amp-list.items > div {
      justify-content: flex-start;
    }

    .close-gallery-button {
      z-index: 1;
      cursor: pointer;
      position: absolute;
      right: -14px;
      top: -14px;
      color: #060606;
      font-size: 18px;
      font-weight: bold;
      border: 1px solid #080808;
      background-color: white;
      width: 26px;
      margin: 0px;
      padding: 0px;
      height: 26px;
      border-radius: 27px;
    }
    .flex{
      display:flex;
    }
    .items-center{
      align-items: center;
    }
    .items, amp-list.items > div {
      justify-content: flex-start;
    }
    .items, amp-list.items > div {
      display: flex;
      justify-content: space-around;
      flex-wrap: wrap;
    }
    .options{
