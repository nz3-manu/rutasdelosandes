    <header class="site-header" role="banner">
      <div class="header-wrapper page-content">
        <a class="site-logo" href="/">
          <amp-img src="/images/logo.png" height="50" width="50">
          </amp-img>
        </a>   
       <div class="cart">
          <amp-list 
          width="auto"
          height="400"
          single-item
          items="."
          layout="fixed-height"
          src="/getcart?clientid=CLIENT_ID(cart)"
          id="dynamic-content">
          <div placeholder>Cargando ...</div>
          <div fallback>Algo fallo en la carga</div>
          <template type="amp-mustache">
            <a class="wrap-cart" on="tap:AMP.setState({cart: {visible: !cart.visible}})" > 
                <amp-img class="cart-icon" src="/images/cart.svg" height="40" width="40"></amp-img>
                {{#number}}
                <div class="cart-items productQ">
                  <span >
                      {{number}}
                  </span>
                </div>
                    {{/number}}
            </a>
            <div [hidden]="cart.visible" class="edit-cart">
              <div class="wrap-shoppingCart">
                  <h2> MI CARRITO DE COMPRAS </h2>
                  <div class="cart-items table">
                    <div class="row headerRows">
  
                    </div>
                    {{^items}}
                    <p>Aun no agregaste productos a tu carrito de compras.</p>
                    {{/items}}
                    {{#items}} 
                      <div class="cart-item row">
                        <span class="cart-item-name cell">{{name}}</span>
                        <span class="cart-item-quantity cell">{{quantity}}</span>
                      </div>
                  {{/items}}
                  </div>
                  <a href="/checkout?clientid=CLIENT_ID(cart)" data-amp-replace="CLIENT_ID" class="buy cartBuy">FINALIZAR COMPRA</a>
                </div>
            </div>

          </template>
      </amp-list>
       </div>

        <button on="tap:sidebar.toggle" class="ampstart-btn caps m2 menu-button">
            <svg viewBox="0 0 18 15" width="35px" height="45px">
              <path fill="#424242" d="M18,1.484c0,0.82-0.665,1.484-1.484,1.484H1.484C0.665,2.969,0,2.304,0,1.484l0,0C0,0.665,0.665,0,1.484,0 h15.031C17.335,0,18,0.665,18,1.484L18,1.484z"/>
              <path fill="#424242" d="M18,7.516C18,8.335,17.335,9,16.516,9H1.484C0.665,9,0,8.335,0,7.516l0,0c0-0.82,0.665-1.484,1.484-1.484 h15.031C17.335,6.031,18,6.696,18,7.516L18,7.516z"/>
              <path fill="#424242" d="M18,13.516C18,14.335,17.335,15,16.516,15H1.484C0.665,15,0,14.335,0,13.516l0,0 c0-0.82,0.665-1.484,1.484-1.484h15.031C17.335,12.031,18,12.696,18,13.516L18,13.516z"/>
            </svg>
        </button>
      </div>
    </header>

    <div class="container main">
      <amp-state id="variationMatrix" >
        <script type="application/json">
          <%- JSON.stringify(product.variations)  %>
        </script>
      </amp-state>
      <amp-state id="product">
          <script type="application/json">
            { 
              "selectedProduct" : "<%- product.defaultChild %>",
              "variationSelected" : <%- JSON.stringify(product.defaultVariations) %>,
              "quantity" : "1"
            }
          </script>
      </amp-state>
      <amp-state id="cart">
          <script type="application/json">
            { 
              "visible" : "false"
              
            }
          </script>
      </amp-state>
      <h2 class="m1"><%= product.title %></h2>
      <div class="product">
      <div class="product-gallery">
        <% product.children.forEach(function(child){ %>
                  <amp-carousel 
                      id="green-apple-carousel"
                      width="1024" height="1024"
                      layout="responsive"
                      type="slides"
                      on="slideChange: AMP.setState({product: { {{color.name}}Slide: event.index}})"
                      class="fadeIn"
                      <% if (product.defaultChild != child.id) { %>
                        hidden
                      <% } %>     
                      [hidden]=" <%= variationsParams %> != '<%= child.id %>'">
                          <amp-img src="<%= child.image.src %>"
                                  width="1024" height="682"
                                  layout="responsive" 
                                  role="button" tabindex="0">
                          </amp-img>
                  </amp-carousel>
                  <p class="porcentajeDescu">
                    <%= product.discount %>
                  </p>
              <% }) %>
              <amp-image-lightbox id="gallery-lightbox" layout="nodisplay">
                <div on="tap:gallery-lightbox.close" role="button"
                    tabindex="0">
                    <button class="ampstart-btn caps m2 close-gallery-button" on="tap:gallery-lightbox.close"
                      role="button" tabindex="0">
                      X
                    </button>
                </div>
              </amp-image-lightbox>
      </div>
      <div class="product-info">
        <div class="variations">
          <% product.shopifyVariations.forEach(function(variation){ %>
            <div class="variation">
              <label class="variation-label" for="<%= replaceAccents(variation.name) %>"><%= variation.name %></label>
              <amp-selector name="<%= replaceAccents(variation.name) %>"
                      layout="container"
                      on="select:AMP.setState({
                        product: {
                          variationSelected:{
                            <%= replaceAccents(variation.name) %> : event.targetOption
                          }
                        }
                      })"
                      [selected]="product.variationSelected['<%= replaceAccents(variation.name) %>']">
                <ul class="options">   
                    <% variation.values.forEach(function(option,index){ %>      
                      <li>
                          <div 
                            <% if (index < 1){ %>
                             selected
                            <% } %>
                            option="<%= option %>"  
                            class="square <%= option.replace(/\s+/g, '-').toLowerCase(); %>">
                        </div>
                      </li>
                    <% }) %>
                </ul>
              </amp-selector>
           </div>
          <% }) %>
        </div>
        <div class="price-wrap">
          <h3 class="price"> $ <%= product.price %> </h3>
          <h3 class="pricePromotion">  </h3>
        </div>
        <form 
          id="checkout" 
          target="_top"
          method="post"
          action-xhr="/addcart"
          class="flex flex-wrap m1">     
            <input type="hidden" name="id" value="<%= product.defaultChild %>" [value]=<%= variationsParams %> >
            <input  type="hidden" name="quantity" value="1" [value]=<%= quantityExpression %> >
            <input name="action" type="hidden" value="checkout" >
        </form>
        <form 
        id="addtocart" 
        target="_top"
        method="post"
        action-xhr="/addcart"
        class="flex flex-wrap m1">     
          <input type="hidden" name="id" value="<%= product.defaultChild %>" [value]=<%= variationsParams %> >
          <input type="hidden" name="url" value="<%= product.url %>" >
          <input  type="hidden" name="quantity" value="1" [value]=<%= quantityExpression %> >
          <input name="action" type="hidden" value="addtocart" >
      </form>
      <amp-lightbox id="checkout-confirm-lightbox"
      layout="nodisplay">
        <div class="lightbox__wrap__btnForm"> 
          <div class="notify-popup">
            <div on="tap:checkout-confirm-lightbox.close" role="button"
            tabindex="0">
              <button class="ampstart-btn caps m2 close-gallery-button" on="tap:checkout-confirm-lightbox.close"
                role="button" tabindex="0">
                  X
              </button>
            </div>
            <button class="buy" on="tap:addtocart.submit" >
              Seguir comprando
            </button>
            <button class="buy" on="tap:checkout.submit" >
              Finalizar compra
            </button>
        </div>
      </div>
    </amp-lightbox>
      <amp-lightbox id="notify-lightbox" 
        layout="nodisplay">
        <!--   Aqui viene el boton -->
          <div class="lightbox__wrap__btnForm"> 
            <div class="notify-popup">

                <div on="tap:notify-lightbox.close" role="button"
                tabindex="0">
                  <button class="ampstart-btn caps m2 close-gallery-button" on="tap:notify-lightbox.close"
                    role="button" tabindex="0">
                      X
                  </button>
                </div>



              <h3 class="notify-popup--tittle">Formulario De Notificación</h3>
              <form
              method="POST"
              id="notify-form"
              action-xhr="/product-notify"
              target="_top"
              on="submit-success:notify-lightbox.close">    
                  <label class="name-label">
                      <span>Nombre</span>
                      <input type="text"
                        name="nombre"
                        placeholder="Nombre"
                        required>
                  </label>  
                  <label class="email-label">
                    <span>Correo Electronico</span>
                    <input type="email"
                      name="correo"
                      placeholder="Correo"
                    >
                </label> 
                  <label class="phone-label">
                      <span>Whatsapp</span>
                      <input type="tel"
                        name="whatsapp"
                        placeholder="Whatsapp"
                        required>
                  </label>
                  <input type="hidden" name="id" value="<%= product.defaultChild %>" [value]=<%= variationsParams %> >
                  <div submit-success>
                      <template type="amp-mustache">
                        Te notificaremos via whatsapp al numero {{celular}} cuando este disponible 
                      </template>
                  </div>
                  <div submit-error>
                        Algo fallo :( 
                  </div>
                  <input  type="submit" class="notify" value="enviar">   
              </form>
            </div>
          </div>
  </amp-lightbox>
      <!--<amp-state id="productAvailavility" src="/product/availability/<%= product.id %>"></amp-state> -->
      <div class="productAvailability">
        <amp-list 
          width="auto"
          height="500"
          layout="fixed-height"
          src="/producto/availability/<%= product.handle %>"
          id="dynamic-content">
          <div placeholder>Cargando ...</div>
          <div fallback>Algo fallo en la carga</div>
          <template type="amp-mustache">
              <div class="single_productAvailability" [hidden]=" <%= variationsParams %> != '{{id}}'" >
                  <div class="availabilityOption" [hidden]="{{total}} != 0">
                    <div class="availabilityOption__textNotification">
                      Este producto se encuentra agotado <br> ¿te gustaría que te notifiquemos cuando este disponible?
                    </div>
                    <button class="notify" value="notificame" on="tap:notify-lightbox" role="button" tabindex="0">  
                      Notifícame
                    </button> 
                  </div>
                  <div class="availabilityOption" [hidden]="{{total}} == 0">
                      <div class="quatity">
                          <div class="quantity-title">
                              Cantidad 
                          </div>
                          <amp-selector
                           on="select:AMP.setState({
                            product: {
                              quantity: event.targetOption
                            }})"
                            selected="1">
                            <ul class="quatity-list">
                              {{#options}}
                                <li option="{{label}}" {{selected}}>{{label}}</li>
                              {{/options}}
                            </ul>
                          </amp-selector>
                      </div>
                    <div class="availabilityOption__textNotification">
                      sólo tenemos  {{total}} disponibles.
                    </div>

                    
                    <button class="buy" on="tap:checkout-confirm-lightbox" >
                      Comprar
                    </button>
                  </div>
              </div>
          </template>
          <div overflow
          class="list-overflow">
            See more
          </div>
        </amp-list>
      </div>
      <amp-selector role="tablist"
        layout="container"
        class="ampTabContainer ampstart-headerbar-nav" keyboard-select-mode="select">
        <div role="tab"
          class="tabButton h4 ampstart-nav-item"
          selected
          option="a">INFORMACIÓN</div>
        <div role="tabpanel"
            class="tabContent p1 p">
          <%- product.descriptionHtml %>
        </div>
        <div role="tab"
          class="tabButton h4 ampstart-nav-item"
          option="b"> ESPECIFICACIONES </div>
        <div role="tabpanel"
          class="tabContent p1 p"><%- product.specification %>
        </div>
      </amp-selector>
      </div>
      </div>
    </div>

    <div class="wrapFoter">
        <div class="footer">
            <div class="contacto">
                <h3> CONTACTO</h3>
                <ul class="li-contacto">
                  <li>Whatsapp y Telefono: 3113403572</li>
                  <li> Correo: rutasdelosandes@gmail.com</li>
                </ul>
                <p>Atendemos de lunes a viernes de 8:00 am a 6:00 pm.</p>
            </div>
            <div class="politicas">
                <h3> POLÍTICAS</h3>
                <ul class="li-politicas">
                  <li><a href="/politicas#politicasPrivacidad" target= ”_blank”>Políticas privacidad</a></li>
                  <li><a href="/politicas#politicasEnvio" target=”_blank”>Políticas de envío</a></li>
                  <li><a href="/politicas#politicasDevolucion" target=”_blank”>Políticas de devolución</a></li>
                </ul>
            </div>
             <div class="pagos">
                <h3> PAGOS</h3>
                <ul class="li-pagos">
                  <li> Pse</li>
                  <li> Efectivo</li>
                  <li> Credito</li>
                  <li> Baloto, Efecty y Apostar su red</li>
                </ul>
            </div>
        </div>
    </div>

  </body>
</html>