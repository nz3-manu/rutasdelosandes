                  "request": "event",
                  "vars": {
                    "eventCategory": "clicCompra",
                    "eventAction": "clickBtnCompra"
                }
                }
            }
          }
          </script>
        </amp-analytics>
        <!-- Google Analytics tracking --> 
        <!-- Facebook Pixel Analytics tracking -->
