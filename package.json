{
  "name": "rutasdelosandes",
  "version": "1.0.0",
  "description": "jekyll theme for publishers, amp, fb instant articles and pwa ",
  "main": "index.html",
  "scripts": {
    "start": "npm run build && babel-node server.js",
    "build": "webpack --env.NODE_ENV=local --config _webpack.config.js &&  JEKYLL_ENV=development bundle exec  jekyll build",
    "build-prod": "webpack --env.NODE_ENV=production --config _webpack.server.js && webpack --env.NODE_ENV=production --config _webpack.config.js && JEKYLL_ENV=prod  bundle exec jekyll build",
    "serve": "node builtserver.js",
    "dev": "DEBUG=express:*  babel-node server.js --plugins transform-es2015-destructuring,transform-object-rest-spread --presets es2015,react "
  },
  "repository": {
    "type": "git",
