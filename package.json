{
  "name": "rutasdelosandes",
  "version": "1.0.0",
  "description": "Static Eleventy site for Rutas de los Andes with PWA support.",
  "main": "index.html",
  "scripts": {
    "styles": "tailwind -i ./styles/tailwind.css -o ./_includes/tailwind.css --minify",
    "styles:watch": "tailwind -i ./styles/tailwind.css -o ./_includes/tailwind.css --watch",
    "eleventy": "eleventy --serve",
    "start": "npm-run-all --parallel styles:watch eleventy",
    "build": "npm run styles && eleventy",
    "debug": "DEBUG=Eleventy* eleventy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jg-rc/rutasdelosandes.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/jg-rc/rutasdelosandes/issues"
  },
  "homepage": "https://github.com/jg-rc/rutasdelosandes#readme",
  "dependencies": {
    "cheerio": "^1.0.0-rc.2"
  },
  "devDependencies": {
    "@11ty/eleventy": "^0.11.0",
    "@11ty/eleventy-img": "^6.0.4",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^3.4.17"
  }
}
