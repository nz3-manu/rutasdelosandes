---
permalink: "documents.json"
---
{
  "expanded": "",
    "activeStep": 0,
    "product": "",
    "shipping": "",
    "payment": "",
    "documents" :{
      <% Object.keys(collections).map((key,index,array)=>{ %>
           "<%- key -%>":[
            <% collections[key].forEach((post,index, array)=>{ %>
               {
                "url": "<%- post.url.replace("/amp", "") -%>",
                "title":"<%- post.data.title -%>",
                "seotitle":"<%- post.data.seotitle -%>",
                "excerpt":"<%- post.data.excerpt -%>",
                "draft":"<%- post.data.draft -%>",
                "author":"<%- post.data.author ? authors[post.data.author].name: "" -%>",
                "author_facebook":"<%-  post.data.author ? authors[post.data.author].facebook: "" -%>",
                "author_twitter":"<%- post.data.author ? authors[post.data.author].twitter: "" -%>",
                "date": "<%- post.date -%>",
                "image": "<%- post.data.images_url -%>/featured.jpg"
               }
               <%- index === array.length -1 ? "":"," -%>
            <% }); %>
          ]
          <%- index === array.length -1 ? "":"," -%>
      <% }); %>
    },
    "site":{
      "seotitle":"<%- site.title -%>",
      "excerpt":"<%- site.description -%>"
    },
    "jekyll":{
      "logo" : "<%- site.logo -%>",
      "brandColor": "<%- site.brand_color -%>",
      "pages" : [
      <% site.menu_pages.forEach((page,index,array)=>{ %>
      {
        "url": "<%- page.url -%>",
        "title" : "<%- page.display -%>"
      }
      <%- index === array.length -1 ? "":"," -%>
      <% }); %>
      ]
    }
}
